import * as THREE from 'three';
import { GLTFExporter } from 'three/addons/exporters/GLTFExporter.js';

// 1. VIEWPORT 3D SETUP
const container = document.getElementById('canvas-viewport');
window.appScene = new THREE.Scene();
const scene = window.appScene;

const camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 1000);
camera.position.set(0, 3, 8);

window.appRenderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
const renderer = window.appRenderer;
renderer.setSize(container.clientWidth, container.clientHeight);
container.appendChild(renderer.domElement);

scene.add(new THREE.AmbientLight(0xffffff, 0.6));
const dirLight = new THREE.DirectionalLight(0x00f3ff, 2.5);
dirLight.position.set(5, 8, 5);
scene.add(dirLight);

window.appKnotMesh = new THREE.Mesh(
    new THREE.TorusKnotGeometry(1.2, 0.35, 128, 32), 
    new THREE.MeshStandardMaterial({ color: 0x151922, metalness: 0.9, roughness: 0.1 })
);
scene.add(window.appKnotMesh);

function animate() {
    requestAnimationFrame(animate);
    if (window.appKnotMesh) {
        window.appKnotMesh.rotation.x += 0.005;
        window.appKnotMesh.rotation.y += 0.01;
    }
    renderer.render(scene, camera);
}
animate();

window.addEventListener('resize', () => {
    camera.aspect = container.clientWidth / container.clientHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(container.clientWidth, container.clientHeight);
});

document.getElementById('export-btn').addEventListener('click', () => {
    const exporter = new GLTFExporter();
    exporter.parse(scene, (gltf) => {
        const blob = new Blob([JSON.stringify(gltf, null, 2)], { type: 'application/json' });
        const link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = 'cyber_scene.gltf';
        link.click();
    }, undefined, { binary: false });
});

// 2. MULTI-FILE WORKSPACE & FOLDER RECURSIVE LOADER
window.openFiles = { 
    'main.js': '// Archivo principal de prueba\nconsole.log("Sistema inicializado correctamente");' 
};
let currentFile = 'main.js';
window.currentFile = 'main.js'; // Expuesto globalmente para las acciones de la IA
window.memoriesCache = []; // Caché global de memorias evolutivas del sistema

const codeEditor = document.getElementById('code-editor');
const tabBar = document.getElementById('tab-bar');

codeEditor.addEventListener('input', () => {
    window.openFiles[currentFile] = codeEditor.value;
});

document.getElementById('folder-input').addEventListener('change', async (e) => {
    const files = Array.from(e.target.files);
    if (!files.length) return;

    let firstTextFile = null;
    for (const file of files) {
        const relativePath = file.webkitRelativePath || file.name;
        const isText = /\.(js|json|html|css|txt|md|py|c|cpp|h|java|ts|jsx|tsx|php|xml|yaml|yml)$/i.test(file.name);

        if (isText) {
            window.openFiles[relativePath] = await file.text();
            if (!firstTextFile) firstTextFile = relativePath;
        } else {
            window.openFiles[relativePath] = `[BINARY RESOURCE / ASSET: ${file.name}]`;
        }
    }
    renderTabs();
    if (firstTextFile) switchTab(firstTextFile);
    buildAndRunProject();
});

function renderTabs() {
    tabBar.innerHTML = '';
    Object.keys(window.openFiles).forEach(fileName => {
        const tab = document.createElement('div');
        tab.className = `tab ${fileName === currentFile ? 'active' : ''}`;
        tab.textContent = fileName;
        tab.onclick = () => switchTab(fileName);
        tabBar.appendChild(tab);
    });
}

function switchTab(fileName) {
    currentFile = fileName;
    window.currentFile = fileName;
    codeEditor.value = window.openFiles[fileName];
    renderTabs();
}

// Función para guardar el proyecto actual en el disco local mediante el servidor Node.js
window.saveProjectToDisk = async function() {
    const payloadFiles = Object.keys(window.openFiles).map(name => ({
        filename: name,
        content: window.openFiles[name]
    }));

    try {
        const res = await fetch('http://localhost:3000/api/save-project', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ files: payloadFiles })
        });
        const data = await res.json();
        if (data.success) {
            console.log(`[💾 DISCO]: ${data.message} | Ubicación: ${data.path}`);
            alert('¡Proyecto guardado físicamente en la carpeta local del servidor!');
        } else {
            alert('Error al guardar: ' + data.error);
        }
    } catch (err) {
        console.error('Error de conexión al guardar el proyecto:', err);
    }
};

// Sincronizar y cargar memorias evolutivas al iniciar
async function fetchMemoriesCache() {
    try {
        const res = await fetch('http://localhost:3000/api/memories');
        window.memoriesCache = await res.json();
        console.log(`[🧠 MEMORIA EVOLUTIVA CARGADA]: ${window.memoriesCache.length} conceptos asimilados.`);
    } catch (err) {
        console.error('No se pudieron cargar las memorias locales:', err);
    }
}
fetchMemoriesCache();

// 3. CHAT RAG AI (EL CEREBRO CENTRAL ORQUESTADOR)
const chatInput = document.getElementById('chat-input');
const chatHistory = document.getElementById('chat-history');
const sendBtn = document.getElementById('send-btn');
const fileInput = document.getElementById('file-input');
const statusInd = document.getElementById('status-indicator');

function appendMessage(role, text) {
    const msgEl = document.createElement('div');
    msgEl.className = `message ${role}`;
    msgEl.textContent = text;
    chatHistory.appendChild(msgEl);
    chatHistory.scrollTop = chatHistory.scrollHeight;
    return msgEl;
}

fileInput.addEventListener('change', async (e) => {
    const file = e.target.files[0];
    if (!file) return;
    const formData = new FormData();
    formData.append('pdf', file);
    statusInd.textContent = 'Indexando y extrayendo conocimientos...';
    try {
        const res = await fetch('http://localhost:3000/api/upload', { method: 'POST', body: formData });
        const data = await res.json();
        statusInd.textContent = '';
        
        // Lectura segura con operadores de cortocircuito para evitar 'undefined' en la interfaz
        appendMessage('assistant', `Cerebro: Documento "${file.name}" procesado.\nFragmentos RAG indexados: ${data.chunks || 0}\nConceptos asimilados a memoria evolutiva: ${data.memoriesExtracted || 0}`);
        
        fetchMemoriesCache();
    } catch (err) {
        statusInd.textContent = 'Error al indexar.';
        appendMessage('assistant', '⚠️ Error al procesar e integrar el documento PDF.');
    }
});

async function submitQuery() {
    const query = chatInput.value.trim();
    if (!query) return;
    appendMessage('user', query);
    chatInput.value = '';
    const assistantMsgEl = appendMessage('assistant', 'Analizando proyecto y consultando matriz de conocimiento...');

    const currentFileContent = codeEditor.value;
    const fileTreeSummary = Object.keys(window.openFiles).join(', ');
    
    const enhancedQuery = `[ESTADO ACTUAL DEL IDE]
Archivo activo en editor: ${currentFile}
Contenido:
${currentFileContent}
Archivos en proyecto: [${fileTreeSummary}]

[PETICIÓN DEL USUARIO]: ${query}`;

    try {
        const response = await fetch('http://localhost:3000/api/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ query: enhancedQuery })
        });
        const reader = response.body.getReader();
        const decoder = new TextDecoder('utf-8');
        assistantMsgEl.textContent = '';
        let fullAiResponse = '';

        while (true) {
            const { value, done } = await reader.read();
            if (done) break;
            const chunk = decoder.decode(value, { stream: true });
            fullAiResponse += chunk;
            assistantMsgEl.textContent += chunk;
            chatHistory.scrollTop = chatHistory.scrollHeight;
        }

        fetchMemoriesCache();

        if (fullAiResponse.includes('```js:action')) {
            const match = fullAiResponse.match(/```js:action([\s\S]*?)```/);
            if (match && match[1]) {
                try {
                    const actionFunction = new Function(match[1]);
                    actionFunction();
                    appendMessage('assistant', '⚙️ [Sistema]: Acción ejecutada exitosamente en el entorno de los 5 paneles.');
                } catch (e) {
                    console.error('Error ejecutando acción IA:', e);
                }
            }
        }

    } catch (err) {
        assistantMsgEl.textContent = 'Error conectando con el servidor local.';
    }
}

sendBtn.addEventListener('click', submitQuery);
chatInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); submitQuery(); }
});

// 4. REAL-TIME CODE AUDIT
document.getElementById('run-audit-btn').addEventListener('click', async () => {
    const auditOutput = document.getElementById('audit-output');
    auditOutput.textContent = '[*] Auditoría de coherencia y errores en curso...\n\n';

    const payloadFiles = Object.keys(window.openFiles).map(name => ({ filename: name, content: window.openFiles[name] }));

    try {
        const res = await fetch('http://localhost:3000/api/analyze-code', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ files: payloadFiles })
        });
        const reader = res.body.getReader();
        const decoder = new TextDecoder('utf-8');
        while (true) {
            const { value, done } = await reader.read();
            if (done) break;
            auditOutput.textContent += decoder.decode(value, { stream: true });
        }
    } catch (err) {
        auditOutput.textContent += '\n[Error] No se pudo completar la auditoría.';
    }
});

// 5. LIVE RUNTIME EXECUTION ENGINE
function buildAndRunProject() {
    const iframe = document.getElementById('runtime-frame');
    const entryHtmlKey = Object.keys(window.openFiles).find(k => k.endsWith('.html')) || Object.keys(window.openFiles)[0];
    let htmlContent = window.openFiles[entryHtmlKey] || '<h1>Carga un archivo HTML válido</h1>';

    const consoleInterceptor = `
        <script>
            (function(){
                const _log = console.log, _err = console.error;
                console.log = function(...args){ _log(...args); window.parent.postMessage({type:'RUNTIME_LOG', data: args.join(' ')}, '*'); };
                console.error = function(...args){ _err(...args); window.parent.postMessage({type:'RUNTIME_ERR', data: args.join(' ')}, '*'); };
                window.onerror = function(msg, url, line){ window.parent.postMessage({type:'RUNTIME_ERR', data: \`Error línea \${line}: \${msg}\`}, '*'); };
            })();
        <\/script>
    `;

    const blob = new Blob([consoleInterceptor + htmlContent], { type: 'text/html' });
    iframe.src = URL.createObjectURL(blob);
}

document.getElementById('run-preview-btn').addEventListener('click', buildAndRunProject);

window.addEventListener('message', async (event) => {
    if (event.data && event.data.type === 'RUNTIME_ERR') {
        const errorMessage = event.data.data;
        const auditOutput = document.getElementById('audit-output');
        auditOutput.textContent += `\n🔴 [RUNTIME ERROR]: ${errorMessage}`;

        // 1. Registrar y aprender del error
        try {
            await fetch('http://localhost:3000/api/learn-from-error', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ error: errorMessage, file: currentFile, code: codeEditor.value })
            });
        } catch (err) {}

        // 2. Solicitar auto-reparación usando las memorias evolutivas y Fast-Track
        try {
            auditOutput.textContent += `\n🤖 [SISTEMA AUTÓNOMO]: Consultando memoria para auto-reparación...`;
            const res = await fetch('http://localhost:3000/api/auto-fix', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ error: errorMessage, file: currentFile, code: codeEditor.value })
            });
            const data = await res.json();

            if (data.success && data.fixedCode !== codeEditor.value) {
                window.openFiles[currentFile] = data.fixedCode;
                codeEditor.value = data.fixedCode;
                auditOutput.textContent += `\n✨ [AUTOCORRECCIÓN APLICADA]: ${data.message}\n`;
                fetchMemoriesCache();
                buildAndRunProject(); // Re-ejecutar automáticamente con el código corregido
            } else {
                auditOutput.textContent += `\n⚠️ [MEMORIA]: ${data.message}\n`;
            }
        } catch (err) {
            auditOutput.textContent += `\n⚠️ Error al intentar auto-reparar el código.`;
        }
    }

    if (event.data && event.data.type === 'RUNTIME_LOG') {
        const auditOutput = document.getElementById('audit-output');
        auditOutput.textContent += `\n🟢 [RUNTIME LOG]: ${event.data.data}`;
    }
});
