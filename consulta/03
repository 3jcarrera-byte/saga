app.post('/api/chat', async (req, res) => {
    try {
        const { query } = req.body;
        if (!query) return res.status(400).json({ error: 'La consulta es obligatoria.' });

        const memories = loadMemories();
        const memoryContext = memories.map(m => `- [${m.lastUpdated}] Concepto: ${m.concept} | Detalles: ${m.details}`).join('\n');

        const queryVector = await generateEmbedding(query);
        const db = loadVectorStore();
        let pdfContext = '';

        if (db.length > 0) {
            const ranked = db.map(entry => ({
                text: entry.text,
                score: cosineSimilarity(queryVector, entry.vector)
            })).sort((a, b) => b.score - a.score);

            pdfContext = ranked.slice(0, 3).map(item => item.text).join('\n---\n');
        }

        const systemPrompt = `Eres el cerebro autónomo, orquestador y director técnico del IDE "Cyber-Studio".
[MEMORIAS DE LARGO PLAZO APRENDIDAS]:
${memoryContext || 'Aún no hay memorias registradas.'}

[CONTEXTO PDF ADICIONAL]:
${pdfContext || 'No hay documentos PDF activos.'}

INSTRUCCIONES CLAVE:
1. APRENDIZAJE: Si aprendes un hecho nuevo, emite un bloque JSON al final:
\`\`\`json:memory
{
  "concept": "Nombre corto",
  "details": "Explicación detallada"
}
\`\`\``;

        res.setHeader('Content-Type', 'text/plain; charset=utf-8');
        res.setHeader('Transfer-Encoding', 'chunked');

        let ollamaAvailable = true;
        let ollamaResponse;

        try {
            // Control de tiempo de 2 segundos para evitar bloqueos si Ollama está cargando
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 2000);

            ollamaResponse = await fetch('http://localhost:11434/api/chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    model: 'llama3',
                    messages: [
                        { role: 'system', content: systemPrompt },
                        { role: 'user', content: query }
                    ],
                    stream: true
                }),
                signal: controller.signal
            });

            clearTimeout(timeoutId);
            if (!ollamaResponse.ok) ollamaAvailable = false;
        } catch (err) {
            ollamaAvailable = false;
        }

        if (!ollamaAvailable) {
            console.log('⚠️ Ollama no disponible o tardando demasiado. Ejecutando motor de respaldo local...');
            const fallbackAnswer = await localFallbackReasoning(query, memories, db, queryVector);
            res.write(fallbackAnswer);
            res.end();
            return;
        }

        const reader = ollamaResponse.body.getReader();
        const decoder = new TextDecoder();
        let fullResponse = '';

        while (true) {
            const { value, done } = await reader.read();
            if (done) break;

            const chunkStr = decoder.decode(value, { stream: true });
            const lines = chunkStr.split('\n');

            for (const line of lines) {
                if (!line.trim()) continue;
                try {
                    const parsed = JSON.parse(line);
                    if (parsed.message && parsed.message.content) {
                        const contentPiece = parsed.message.content;
                        fullResponse += contentPiece;
                        res.write(contentPiece);
                    }
                } catch (e) {}
            }
        }

        const memoryMatch = fullResponse.match(/```json:memory([\s\S]*?)```/);
        if (memoryMatch && memoryMatch[1]) {
            try {
                const memObj = JSON.parse(memoryMatch[1].trim());
                if (memObj.concept && memObj.details) {
                    smartUpsertMemory(memObj.concept, memObj.details);
                    console.log(`[MEMORIA EVOLUTIVA GUARDADA]: ${memObj.concept}`);
                }
            } catch (err) {}
        }

        res.end();

    } catch (error) {
        console.error('Error en el chat:', error);
        if (!res.headersSent) {
            res.status(500).json({ error: 'No se pudo conectar con Ollama.' });
        } else {
            res.end('\n[Error de transmisión]');
        }
    }
});

