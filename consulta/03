// ENDPOINT DE APRENDIZAJE AUTÓNOMO DE ERRORES (RUNTIME)
// ==========================================
app.post('/api/learn-from-error', async (req, res) => {
    try {
        const { error, file, code } = req.body;
        if (!error) return res.status(400).json({ error: 'Falta el mensaje de error.' });

        const errorTypeMatch = error.match(/([a-zA-Z]+Error|SyntaxError|TypeError|ReferenceError)/);
        const errorKey = errorTypeMatch ? errorTypeMatch[1] : 'Error de Ejecución';
        
        const conceptName = `Fallo de Runtime: ${errorKey} en ${file || 'código'}`;
        const errorDetails = `El código generó el error: "${error}". Archivo afectado: ${file}. Se recomienda revisar declaraciones de variables, dependencias o lógica.`;

        const result = smartUpsertMemory(conceptName, errorDetails);

        return res.json({
            success: true,
            message: `Registrado en memoria evolutiva (${result.message})`,
            concept: conceptName
        });
    } catch (err) {
        console.error('Error procesando aprendizaje de error:', err);
        return res.status(500).json({ error: 'Fallo al registrar el error.' });
    }
});

// ==========================================
// ENDPOINT DE AUTO-CORRECCIÓN VELOZ (FAST-TRACK & MEMORY)
// ==========================================
app.post('/api/auto-fix', async (req, res) => {
    try {
        const { error, file, code } = req.body;
        if (!error || !code) return res.status(400).json({ error: 'Faltan datos para la auto-corrección.' });

        const fastCheck = brainEngine.queryFastMemory(error);
        if (fastCheck.fastTrack) {
            return res.json({
                success: true,
                fixedCode: fastCheck.patch,
                message: '⚡ Auto-reparado instantáneamente mediante Memoria Rápida.'
            });
        }

        const memories = loadMemories();
        const errorTypeMatch = error.match(/([a-zA-Z]+Error|SyntaxError|TypeError|ReferenceError)/);
        const errorKey = errorTypeMatch ? errorTypeMatch[1] : '';

        const matchedMemory = memories.find(m => 
            m.concept.toLowerCase().includes(errorKey.toLowerCase()) || 
            (file && m.details.toLowerCase().includes(file.toLowerCase()))
        );

        let fixedCode = code;
        let fixExplanation = '';

        if (error.includes('is not defined') && error.includes('THREE')) {
            fixExplanation = 'Se detectó un objeto de Three.js no definido. Añadiendo importación correcta.';
            if (!code.includes('import * as THREE')) {
                fixedCode = `import * as THREE from 'three';\n` + code;
            }
        } else if (matchedMemory) {
            fixExplanation = `Aplicando solución basada en memoria evolutiva: "${matchedMemory.concept}"`;
            fixedCode = `// [Auto-reparado por Memoria Evolutiva]: ${matchedMemory.concept}\n` + code;
        } else {
            fixExplanation = 'El error fue registrado en la base de conocimiento local.';
        }

        brainEngine.learnPattern(error, fixedCode);

        return res.json({
            success: true,
            fixedCode: fixedCode,
            message: fixExplanation
        });

    } catch (err) {
        console.error('Error en el proceso de auto-corrección:', err);
        return res.status(500).json({ error: 'Fallo al procesar la auto-reparación.' });
    }
});

