// ==========================================
// MOTOR DE META-APRENDIZAJE Y MEMORIA RÁPIDA (FAST TRACK)
// ==========================================
class FastEvolutionEngine {
    constructor() {
        this.memoryPath = FAST_BRAIN_FILE;
        this.memory = this.loadFastMemory();
    }

    loadFastMemory() {
        try {
            if (fs.existsSync(this.memoryPath)) {
                return JSON.parse(fs.readFileSync(this.memoryPath, 'utf-8'));
            }
        } catch (e) {
            console.error('Error cargando fast_brain.json:', e);
        }
        return { patterns: [] };
    }

    createSignature(errorText) {
        return errorText.replace(/:\d+:\d+/g, '').slice(0, 150).trim();
    }

    queryFastMemory(errorText) {
        const signature = this.createSignature(errorText);
        const match = this.memory.patterns.find(p => p.signature === signature);
        if (match) {
            match.hits += 1;
            this.persist();
            return { fastTrack: true, patch: match.patch };
        }
        return { fastTrack: false };
    }

    learnPattern(errorText, patch) {
        const signature = this.createSignature(errorText);
        const existing = this.memory.patterns.find(p => p.signature === signature);
        
        if (!existing) {
            this.memory.patterns.push({
                signature,
                patch,
                hits: 1,
                learnedAt: new Date().toISOString()
            });
            this.persist();
        }
    }

    persist() {
        fs.writeFileSync(this.memoryPath, JSON.stringify(this.memory, null, 2), 'utf-8');
    }
}

const brainEngine = new FastEvolutionEngine();

// ==========================================
// UTILIDADES DE MEMORIA EVOLUTIVA Y RAG
// ==========================================

function loadMemories() {
    try {
        const data = fs.readFileSync(MEMORY_FILE, 'utf-8');
        return JSON.parse(data);
    } catch {
        return [];
    }
}

function saveMemories(memories) {
    fs.writeFileSync(MEMORY_FILE, JSON.stringify(memories, null, 2));
}

function smartUpsertMemory(concept, details) {
    const memories = loadMemories();
    const today = new Date().toISOString().split('T')[0];
    
    const existingIndex = memories.findIndex(m => m.concept.toLowerCase() === concept.toLowerCase());

    if (existingIndex !== -1) {
        if (memories[existingIndex].details.toLowerCase() === details.toLowerCase()) {
            return { updated: false, message: 'Memoria ya existente idéntica, omitida.' };
        } else {
            memories[existingIndex].details = details;
            memories[existingIndex].lastUpdated = today;
            memories[existingIndex].version = (memories[existingIndex].version || 1) + 1;
            saveMemories(memories);
            return { updated: true, message: 'Memoria actualizada con nuevos detalles.' };
        }
    } else {
        memories.push({
            id: Date.now(),
            concept: concept,
            details: details,
            dateCreated: today,
            lastUpdated: today,
            version: 1
        });
        saveMemories(memories);
        return { updated: true, message: 'Nueva memoria registrada con éxito.' };
    }
}

function cosineSimilarity(vecA, vecB) {
    let dotProduct = 0;
    let normA = 0;
    let normB = 0;
    for (let i = 0; i < vecA.length; i++) {
        dotProduct += vecA[i] * vecB[i];
        normA += vecA[i] * vecA[i];
        normB += vecB[i] * vecB[i];
    }
    return dotProduct / (Math.sqrt(normA) * Math.sqrt(normB));
}

function loadVectorStore() {
    if (!fs.existsSync(DB_FILE)) return [];
    try {
        return JSON.parse(fs.readFileSync(DB_FILE, 'utf-8'));
    } catch {
        return [];
    }
}

function saveVectorStore(data) {
    fs.writeFileSync(DB_FILE, JSON.stringify(data, null, 2));
}

async function generateEmbedding(text) {
    while (!embedder) {
        await new Promise(resolve => setTimeout(resolve, 100));
    }
    const output = await embedder(text, { pooling: 'mean', normalize: true });
    return Array.from(output.data);
}

// ==========================================
// ENDPOINT DE CHAT: MOTOR DE SÍNTESIS Y ENSAMBLE SEMÁNTICO LOCAL
// ==========================================
app.post('/api/chat', async (req, res) => {
    try {
        const { query } = req.body;
        if (!query) return res.status(400).json({ error: 'La consulta es obligatoria.' });

        res.setHeader('Content-Type', 'text/plain; charset=utf-8');

        // 1. Generación de vector de la consulta
        const queryVector = await generateEmbedding(query);

        // 2. Búsqueda en la Memoria Evolutiva (memories.json)
        const memories = loadMemories();
        let bestMemoryMatch = null;
        let highestMemoryScore = -1;

        for (const mem of memories) {
            const memText = `${mem.concept}: ${mem.details}`;
            const memVector = await generateEmbedding(memText);
            const score = cosineSimilarity(queryVector, memVector);

            if (score > highestMemoryScore) {
                highestMemoryScore = score;
                bestMemoryMatch = mem;
            }
        }

        // 3. Búsqueda en la Matriz Vectorial de Chunks (vector_matrix.json)
        const db = loadVectorStore();
        let rankedChunks = [];

        if (db.length > 0) {
            rankedChunks = db.map(entry => ({
                text: entry.text,
                source: entry.source || 'Documento PDF',
                score: cosineSimilarity(queryVector, entry.vector)
            })).sort((a, b) => b.score - a.score);
        }

        const topChunks = rankedChunks.filter(item => item.score > 0.25).slice(0, 3);
        const hasHighConfidenceMem = bestMemoryMatch && highestMemoryScore > 0.35;
        const hasHighConfidenceChunk = topChunks.length > 0;

        // 4. Generación de Respuesta por Ensamble Semántico
        if (!hasHighConfidenceMem && !hasHighConfidenceChunk) {
            const fallbackMsg = `⚠️ [Cerebro Local E.V.A.I.]: No encontré coincidencias semánticas suficientes para responder a tu consulta.\n\n` +
                `💡 **Sugerencia:** Sube un archivo PDF relevante usando el panel de ingesta o escribe código para que el sistema asimile este conocimiento en su memoria evolutiva.`;
            res.write(fallbackMsg);
            res.end();
            return;
        }

        let responseText = `🧠 [Cerebro Autónomo Local - Ensamble Semántico]\n\n`;

        if (hasHighConfidenceMem) {
            responseText += `🔹 **Concepto Aprendido:** ${bestMemoryMatch.concept} (Confianza: ${(highestMemoryScore * 100).toFixed(1)}%)\n`;
            responseText += `📖 **Detalles:** ${bestMemoryMatch.details}\n\n`;
        }

        if (hasHighConfidenceChunk) {
            responseText += `📚 **Conocimiento Relevante Extraído de Documentos:**\n\n`;
            topChunks.forEach((chunk, index) => {
                responseText += `> **[Fuente: ${chunk.source} | Coincidencia: ${(chunk.score * 100).toFixed(1)}%]**\n`;
                responseText += `${chunk.text}\n\n`;
            });
        }

        res.write(responseText);
        res.end();

    } catch (error) {
        console.error('Error en la síntesis del chat local:', error);
        if (!res.headersSent) {
            res.status(500).json({ error: 'Fallo al procesar la síntesis semántica.' });
        } else {
            res.end('\n[Error en el motor de síntesis local]');
        }
    }
});

// ==========================================
// ENDPOINT DE SUBIDA E INGESTIÓN DE PDF
// ==========================================
app.post('/api/upload', upload.single('pdf'), async (req, res) => {
    try {
        if (!req.file) return res.status(400).json({ error: 'No se adjuntó ningún archivo PDF.' });

        const dataBuffer = fs.readFileSync(req.file.path);
        const parsedData = await pdfParse(dataBuffer);
        const rawText = parsedData.text;

        fs.unlinkSync(req.file.path);

        const chunkSize = 500;
        const overlap = 100;
        const chunks = [];
        
        let start = 0;
        while (start < rawText.length) {
            const chunk = rawText.slice(start, start + chunkSize).replace(/\s+/g, ' ').trim();
            if (chunk.length > 20) chunks.push(chunk);
            start += chunkSize - overlap;
        }

        const dbEntries = [];
        let extractedMemoriesCount = 0;

        for (let i = 0; i < chunks.length; i++) {
            const textChunk = chunks[i];
            const vector = await generateEmbedding(textChunk);
            
            dbEntries.push({
                id: `${Date.now()}_${i}`,
                text: textChunk,
                vector: vector,
                source: req.file.originalname
            });

            const sentences = textChunk.split(/(?<=[.?!])\s+/);
            for (const sentence of sentences) {
                const cleanSentence = sentence.trim();
                if (cleanSentence.length < 15) continue;

                const pattern = /([^.]+?)\s+(?:es|se\s+define\s+como|consiste\s+en)\s+([^.]+)/i;
                const match = cleanSentence.match(pattern);

                if (match && match.length >= 3) {
                    let conceptCandidate = match[1].replace(/[^a-zA-Z0-9áéíóúÁÉÍÓÚñÑ\s\-_]/g, '').trim();
                    let detailsCandidate = match[2].trim();

                    if (conceptCandidate.length > 2 && conceptCandidate.length < 50 && detailsCandidate.length > 10) {
                        conceptCandidate = conceptCandidate.charAt(0).toUpperCase() + conceptCandidate.slice(1);
                        smartUpsertMemory(conceptCandidate, `[Extraído de ${req.file.originalname}]: ${detailsCandidate}`);
                        extractedMemoriesCount++;
                    }
                }
            }
        }

        const currentDb = loadVectorStore();
        saveVectorStore([...currentDb, ...dbEntries]);

        return res.json({ 
            success: true, 
            chunks: dbEntries.length, 
            memoriesExtracted: extractedMemoriesCount,
            message: `PDF indexado y ${extractedMemoriesCount} conceptos asimilados en la memoria evolutiva.` 
        });

    } catch (error) {
        console.error('Error procesando el PDF:', error);
        return res.status(500).json({ error: 'Fallo al procesar e indexar el documento.' });
    }
});

