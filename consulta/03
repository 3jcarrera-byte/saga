// ==========================================
// 4. ENDPOINT PARA GUARDAR ARCHIVOS EN EL DISCO LOCAL
// ==========================================
app.post('/api/save-project', (req, res) => {
    try {
        const { files } = req.body;
        if (!files || !Array.isArray(files) || files.length === 0) {
            return res.status(400).json({ error: 'No se proporcionaron archivos válidos para guardar.' });
        }

        const PROJECT_ROOT = path.join('./local_brain_db', 'saved_project');
        if (!fs.existsSync(PROJECT_ROOT)) {
            fs.mkdirSync(PROJECT_ROOT, { recursive: true });
        }

        let savedCount = 0;

        for (const file of files) {
            if (!file.filename || typeof file.content !== 'string') continue;

            const safePath = path.normalize(file.filename).replace(/^(\.\.[\/\\])+/, '');
            const absoluteFilePath = path.join(PROJECT_ROOT, safePath);
            const fileDir = path.dirname(absoluteFilePath);

            if (!fs.existsSync(fileDir)) {
                fs.mkdirSync(fileDir, { recursive: true });
            }

            fs.writeFileSync(absoluteFilePath, file.content, 'utf-8');
            savedCount++;
        }

        return res.json({ 
            success: true, 
            message: `Se guardaron ${savedCount} archivos exitosamente en la carpeta local.`,
            path: path.resolve(PROJECT_ROOT)
        });

    } catch (error) {
        console.error('Error al guardar el proyecto en el disco:', error);
        return res.status(500).json({ error: 'Fallo al escribir los archivos en el disco local.' });
    }
});

