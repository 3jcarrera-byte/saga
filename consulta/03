function loadMemories() {
    try {
        const data = fs.readFileSync(MEMORY_FILE, 'utf-8');
        return JSON.parse(data);
    } catch {
        return [];
    }
}

function saveMemories(memories) {
    fs.writeFileSync(MEMORY_FILE, JSON.stringify(memories, null, 2));
}

function smartUpsertMemory(concept, details) {
    const memories = loadMemories();
    const today = new Date().toISOString().split('T')[0];
    
    const existingIndex = memories.findIndex(m => m.concept.toLowerCase() === concept.toLowerCase());

    if (existingIndex !== -1) {
        if (memories[existingIndex].details.toLowerCase() === details.toLowerCase()) {
            return { updated: false, message: 'Memoria ya existente idéntica, omitida.' };
        } else {
            memories[existingIndex].details = details;
            memories[existingIndex].lastUpdated = today;
            memories[existingIndex].version = (memories[existingIndex].version || 1) + 1;
            saveMemories(memories);
            return { updated: true, message: 'Memoria actualizada con nuevos detalles.' };
        }
    } else {
        memories.push({
            id: Date.now(),
            concept: concept,
            details: details,
            dateCreated: today,
            lastUpdated: today,
            version: 1
        });
        saveMemories(memories);
        return { updated: true, message: 'Nueva memoria registrada con éxito.' };
    }
}

function cosineSimilarity(vecA, vecB) {
    let dotProduct = 0;
    let normA = 0;
    let normB = 0;
    for (let i = 0; i < vecA.length; i++) {
        dotProduct += vecA[i] * vecB[i];
        normA += vecA[i] * vecA[i];
        normB += vecB[i] * vecB[i];
    }
    return dotProduct / (Math.sqrt(normA) * Math.sqrt(normB));
}

function loadVectorStore() {
    if (!fs.existsSync(DB_FILE)) return [];
    try {
        return JSON.parse(fs.readFileSync(DB_FILE, 'utf-8'));
    } catch {
        return [];
    }
}

function saveVectorStore(data) {
    fs.writeFileSync(DB_FILE, JSON.stringify(data, null, 2));
}

async function generateEmbedding(text) {
    const output = await embedder(text, { pooling: 'mean', normalize: true });
    return Array.from(output.data);
}

// ==========================================
// MOTOR DE RESPALDO LOCAL (SIN OLLAMA)
// ==========================================
async function localFallbackReasoning(query, memories, vectorDb, queryVector) {
    let bestMatch = null;
    let highestScore = -1;

    for (const mem of memories) {
        const memText = `${mem.concept}: ${mem.details}`;
        const memVector = await generateEmbedding(memText);
        const score = cosineSimilarity(queryVector, memVector);
        
        if (score > highestScore) {
            highestScore = score;
            bestMatch = mem;
        }
    }

    if (bestMatch && highestScore > 0.35) {
        let responseText = `🧠 [Modo Respaldo Local Autónomo - Ollama Inactivo]\n\n`;
        responseText += `He recuperado este conocimiento de mi memoria evolutiva (Confianza: ${(highestScore * 100).toFixed(1)}%):\n\n`;
        responseText += `🔹 **Concepto:** ${bestMatch.concept}\n`;
        responseText += `📖 **Detalles:** ${bestMatch.details}\n\n`;
        responseText += `*Nota: El sistema local mantiene el editor sincronizado con tu archivo activo a través de window.currentFile.*`;
        return responseText;
    }

    return `⚠️ [Modo Respaldo Local]: Ollama está desconectado y no encontré un concepto lo suficientemente similar en las memorias locales para responder a: "${query}". Prueba encendiendo Ollama o subiendo un PDF con este conocimiento.`;
}

