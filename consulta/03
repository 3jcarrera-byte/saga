// ==========================================
// MOTOR DE META-APRENDIZAJE Y MEMORIA RÁPIDA (FAST TRACK)
// ==========================================
class FastEvolutionEngine {
    constructor() {
        this.memoryPath = FAST_BRAIN_FILE;
        this.memory = this.loadFastMemory();
    }

    loadFastMemory() {
        try {
            if (fs.existsSync(this.memoryPath)) {
                return JSON.parse(fs.readFileSync(this.memoryPath, 'utf-8'));
            }
        } catch (e) {
            console.error('Error cargando fast_brain.json:', e);
        }
        return { patterns: [] };
    }

    createSignature(errorText) {
        return errorText.replace(/:\d+:\d+/g, '').slice(0, 150).trim();
    }

    queryFastMemory(errorText) {
        const signature = this.createSignature(errorText);
        const match = this.memory.patterns.find(p => p.signature === signature);
        if (match) {
            match.hits += 1;
            this.persist();
            return { fastTrack: true, patch: match.patch };
        }
        return { fastTrack: false };
    }

    learnPattern(errorText, patch) {
        const signature = this.createSignature(errorText);
        const existing = this.memory.patterns.find(p => p.signature === signature);
        
        if (!existing) {
            this.memory.patterns.push({
                signature,
                patch,
                hits: 1,
                learnedAt: new Date().toISOString()
            });
            this.persist();
        }
    }

    persist() {
        fs.writeFileSync(this.memoryPath, JSON.stringify(this.memory, null, 2), 'utf-8');
    }
}

const brainEngine = new FastEvolutionEngine();

// ==========================================
