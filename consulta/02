<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cyber-Studio 5-Panel Autonomous AI IDE</title>
    <!-- Hoja de estilos -->
    <link rel="stylesheet" href="styles.css">
    <!-- Import map para Three.js y dependencias corregido -->
    <script type="importmap">
    {
        "imports": {
            "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
            "three/addons/": "https://unpkg.com/three@0.160.0/examples/jsm/"
        }
    }
    </script>
</head>
<body>

<div id="workspace">
    <!-- PANEL 1: VIEWPORT 3D -->
    <div class="panel" id="viewport-container">
        <div id="canvas-viewport">
            <button id="export-btn">EXPORT GLTF</button>
        </div>
    </div>

    <!-- PANEL 2: CODE WORKSPACE & FOLDER TREE -->
    <div class="panel">
        <div class="panel-header">
            <span>Code Workspace</span>
            <div class="header-actions">
                <label style="cursor: pointer; color: var(--accent-cyan); font-size: 0.75rem;">
                    📁 Cargar Carpeta <input type="file" id="folder-input" webkitdirectory directory multiple style="display:none">
                </label>
            </div>
        </div>
        <div class="tab-bar" id="tab-bar">
            <div class="tab active" data-file="main.js">main.js</div>
        </div>
        <textarea id="code-editor" spellcheck="false">// Escribe tu programa aquí&#10;console.log("Cyber-Studio inicializado correctamente");</textarea>
    </div>

    <!-- PANEL 3: CHAT RAG AI (EL CEREBRO CENTRAL) -->
    <div class="panel">
        <div class="panel-header">
            <span>Autonomous AI Brain</span>
            <div id="status-indicator"></div>
        </div>
        <div id="chat-history"></div>
        <div class="chat-controls">
            <label class="file-upload-label">
                📁 Subir PDF Contexto
                <input type="file" id="file-input" accept=".pdf">
            </label>
            <div class="input-row">
                <textarea id="chat-input" placeholder="Ordena a la IA modificar el 3D, corregir código o auditar el proyecto..."></textarea>
                <button class="action-btn" id="send-btn">EXECUTE</button>
            </div>
        </div>
    </div>

    <!-- PANEL 4: AUDITORÍA DE ERRORES -->
    <div class="panel">
        <div class="panel-header">
            <span>Real-Time Error Matrix</span>
            <button class="btn-audit" id="run-audit-btn">ANALYZE PROJECT</button>
        </div>
        <div id="audit-output">Cerebro AI activo. Los errores del entorno de ejecución y los fallos de lógica aparecerán aquí en tiempo real.</div>
    </div>

    <!-- PANEL 5: LIVE RUNTIME CANVAS (EJECUCIÓN EN VIVO) -->
    <div class="panel" id="panel-runtime">
        <div class="panel-header" style="background: #08090d; color: var(--accent-green);">
            <span>Live App Execution Runtime</span>
            <button class="action-btn" id="run-preview-btn" style="height: 24px; padding: 0 10px; font-size: 0.72rem; background: var(--accent-green); color: #000;">
                ▶ RUN / REFRESH
            </button>
        </div>
        <iframe id="runtime-frame" sandbox="allow-scripts allow-same-origin"></iframe>
    </div>
</div>

<!-- Archivo JavaScript principal cargado como módulo -->
<script type="module" src="app.js"></script>
</body>
</html>
