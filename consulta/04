:root {
    --bg-color: #0a0b10;
    --panel-bg: #12151e;
    --accent-cyan: #00f3ff;
    --accent-magenta: #ff0055;
    --accent-green: #62fe80;
    --text-main: #e0e6ed;
    --text-dim: #7a8b9e;
    --border: #1e2638;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
}

body {
    background-color: var(--bg-color);
    color: var(--text-main);
    height: 100vh;
    overflow: hidden;
}

/* --- Grid de 5 Paneles (Diseño Balanceado 3x2) --- */
#workspace {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    width: 100vw;
    height: 100vh;
    gap: 2px;
    background-color: var(--border);
}

.panel {
    background-color: var(--panel-bg);
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.panel-header {
    padding: 10px 16px;
    background: #0d0e14;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--accent-cyan);
    text-transform: uppercase;
}

.header-actions {
    display: flex;
    gap: 10px;
    align-items: center;
}

/* --- Panel 1: Viewport 3D --- */
#canvas-viewport {
    position: relative;
    background: radial-gradient(circle at center, #151928 0%, #08090d 100%);
    width: 100%;
    height: 100%;
}

#export-btn {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 10;
    background: rgba(0, 243, 255, 0.1);
    border: 1px solid var(--accent-cyan);
    color: var(--accent-cyan);
    padding: 6px 12px;
    font-weight: 600;
    cursor: pointer;
    border-radius: 4px;
    box-shadow: 0 0 10px rgba(0, 243, 255, 0.2);
    transition: all 0.2s ease;
}

#export-btn:hover {
    background: var(--accent-cyan);
    color: #000;
}

/* --- Panel 2: Editor de Código y Árbol de Carpetas --- */
.tab-bar {
    display: flex;
    background: #08090d;
    border-bottom: 1px solid var(--border);
    overflow-x: auto;
    scrollbar-width: thin;
}

.tab {
    padding: 8px 12px;
    font-size: 0.75rem;
    color: var(--text-dim);
    border-right: 1px solid var(--border);
    cursor: pointer;
    background: #0d0e14;
    white-space: nowrap;
    user-select: none;
}

.tab.active {
    color: var(--accent-cyan);
    background: var(--panel-bg);
    border-bottom: 2px solid var(--accent-cyan);
}

#code-editor {
    flex: 1;
    background: #0b0c12;
    color: #a9b7c6;
    border: none;
    padding: 14px;
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 0.88rem;
    resize: none;
    outline: none;
    line-height: 1.4;
    tab-size: 4;
}

/* --- Panel 3: Chat RAG AI (El Cerebro Central) --- */
#chat-history {
    flex: 1;
    overflow-y: auto;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.message {
    max-width: 90%;
    padding: 10px 12px;
    border-radius: 6px;
    line-height: 1.4;
    font-size: 0.85rem;
    white-space: pre-wrap;
}

.message.user {
    align-self: flex-end;
    background: rgba(0, 243, 255, 0.15);
    border: 1px solid rgba(0, 243, 255, 0.4);
    color: #fff;
}

.message.assistant {
    align-self: flex-start;
    background: #181c28;
    border: 1px solid var(--border);
    color: var(--text-main);
}

.chat-controls {
    padding: 10px 12px;
    border-top: 1px solid var(--border);
    background: #0d0e14;
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.input-row {
    display: flex;
    gap: 6px;
    align-items: flex-end;
}

#chat-input {
    flex: 1;
    background: #141824;
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text-main);
    padding: 8px;
    font-size: 0.85rem;
    resize: none;
    max-height: 100px;
    min-height: 36px;
    outline: none;
}

#chat-input:focus { border-color: var(--accent-cyan); }

.action-btn {
    background: var(--accent-cyan);
    border: none;
    color: #000;
    font-weight: 700;
    padding: 0 14px;
    border-radius: 4px;
    cursor: pointer;
    height: 36px;
}

.action-btn:hover { opacity: 0.9; }

.file-upload-label {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--text-dim);
    font-size: 0.75rem;
    cursor: pointer;
}
.file-upload-label:hover { color: var(--accent-cyan); }
#file-input { display: none; }
#status-indicator { font-size: 0.75rem; color: var(--accent-magenta); }

/* --- Panel 4: Auditoría de Errores --- */
#audit-output {
    flex: 1;
    padding: 12px;
    overflow-y: auto;
    font-family: 'Consolas', monospace;
    font-size: 0.82rem;
    color: var(--accent-green);
    background: #07080c;
    white-space: pre-wrap;
    line-height: 1.4;
}

.btn-audit {
    background: var(--accent-magenta);
    color: #fff;
    border: none;
    padding: 4px 10px;
    font-weight: 700;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.72rem;
}

/* --- Panel 5: Live App Execution Runtime --- */
#panel-runtime {
    background: #ffffff;
    grid-column: span 2;
}
#runtime-frame {
    width: 100%;
    height: 100%;
    border: none;
    background: #ffffff;
}
